# Supabase client configuration (publishable values)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only Cloudinary credential. Never commit the real value.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Public production site URL used for SEO, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://green-x-lake.vercel.app

# Optional public URL to a company profile PDF.
NEXT_PUBLIC_COMPANY_PROFILE_URL=

# Admin access allowlist used by the Next.js application.
ADMIN_EMAIL=admin@google.com
